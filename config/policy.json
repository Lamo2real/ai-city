{
  "audit_log": "~/.jarvis/audit.jsonl",
  "caps": {
    "ad_daily_budget_cents": 5000,
    "max_active_agents_per_department": 5,
    "department_caps": {},
    "max_workers_per_manager": 4,
    "daily_spend_usd_per_department": 20,
    "max_review_rounds": 3,
    "max_concurrent_turns": 4,
    "turn_timeout_minutes": 60,
    "resume_max_age_hours": 1
  },
  "models": {
    "simple": "claude-haiku-5-5",
    "standard": "claude-sonnet-5-5",
    "complex": "claude-opus-5-5",
    "fallback": { "claude-fable-5-1": "claude-opus-5-5", "claude-opus-5-5": "claude-sonnet-5-5", "claude-sonnet-5-5": "claude-haiku-5-5" },
    "prices_per_mtok": {
      "claude-fable-5-1": { "input": 10, "output": 50, "cache_read": 0.25, "cache_write": 20 },
      "claude-opus-5-5": { "input": 4, "output": 20, "cache_read": 0.2, "cache_write": 8 },
      "claude-sonnet-5-5": { "input": 2, "output": 10, "cache_read": 0.1, "cache_write": 4 },
      "claude-haiku-5-5": { "input": 0.1, "output": 0.5, "cache_read": 0.01, "cache_write": 0.2 }
    }
  },
  "autonomy": { "read_tools": ["Read", "Grep", "Glob", "read", "web_search", "web_fetch", "WebSearch", "WebFetch"] },
  "repos_roots": ["~/projects", "/tmp"],
  "session": {
    "compact_at_context_pct": 60,
    "model_context_tokens": { "opus": 200000, "sonnet": 200000, "haiku": 200000, "fable": 200000, "default": 200000 }
  },
  "rules": [
    { "tool": "^(Bash|exec|bash|process)$", "match": "\\bsecurity\\s+(add|delete|set|unlock|find)-", "decision": "deny", "reason": "Agents do not touch the Keychain. Secrets reach a process through its launcher." },
    { "tool": "^(Bash|exec|bash|process)$", "match": "\\b(stripe\\s+(charges|payment_intents|refunds|payouts|transfers)\\b.*(create|capture|confirm)|npm\\s+publish|gh\\s+secret\\s+set|gh\\s+release\\s+create)", "decision": "ask", "reason": "Payments, publishing and credential changes need the owner." },
    { "tool": "^(Bash|exec|bash|process)$", "match": "\\baws\\b.*\\b(delete|terminate|remove|deregister|destroy)-", "decision": "ask", "reason": "Deleting cloud resources needs the owner." },
    { "tool": "^(Bash|exec|bash|process)$", "match": "\\b(drop\\s+(table|database)|truncate\\s+table)\\b", "decision": "ask", "reason": "Destructive database statements need the owner." },
    { "tool": "^(Bash|exec|bash|process)$", "match": "git(\\s+-\\S+(\\s+[^-\\s]\\S*)?)*\\s+push\\b.*(--force|-f\\b)", "decision": "deny", "reason": "Force-push is never allowed." },
    { "tool": "^(Bash|exec|bash|process)$", "match": "git(\\s+-\\S+(\\s+[^-\\s]\\S*)?)*\\s+push\\b.*\\b(main|master)\\b", "decision": "deny", "reason": "Never push to main. Open a PR; the Fable reviewer gates merges." },
    { "tool": "^(Bash|exec|bash|process)$", "match": "(^|[\\s\"';&|(])git\\s+([^;&|]*\\s)?(-c\\s|--output|--ext-diff|--textconv)", "decision": "deny", "reason": "git -c, --output, --ext-diff and --textconv can run programs or write files; not allowed." },
    { "tool": "^(Bash|exec|bash|process)$", "match": "(^|[\\s\"';&|(])git\\s[^;&|]*(\\d?>(?!&[0-9-])|&>)", "decision": "deny", "reason": "Redirecting git output into a file (>, >>, 1>, 2>, &>) is a write path; not allowed. 2>&1 and >&2 are fine." },
    { "tool": "^(Bash|exec|bash|process)$", "match": "gh\\s+repo\\s+delete", "decision": "deny", "reason": "Deleting repositories needs the owner, by hand." },
    { "tool": "^(Bash|exec|bash|process)$", "match": "rm\\s+-[a-zA-Z]*r[a-zA-Z]*f?\\s+(/|~|\\$HOME)/?(\\s|\\\"|$)", "decision": "deny", "reason": "Recursive delete of root or home." },
    { "tool": "^(Bash|exec|bash|process)$", "match": "terraform\\s+destroy", "decision": "ask", "reason": "Terraform destroy needs the owner." },
    { "tool": "^(Bash|exec|bash|process)$", "match": "terraform\\s+apply\\b.*prod", "decision": "ask", "reason": "Production apply needs the owner." },
    { "tool": "^(Bash|exec|bash|process)$", "match": "(curl|wget)[^|]*\\|\\s*(ba|z)?sh", "decision": "deny", "reason": "Piping downloads into a shell." },
    { "tool": "^(Bash|exec|bash|process)$", "match": "gh\\s+api\\b.*(-X|--method)[\\s=]*(PUT|DELETE|PATCH)", "decision": "ask", "reason": "Changing GitHub through its API needs the owner." },
    { "tool": "^(Bash|exec|bash|process)$", "match": "gh\\s+pr\\s+merge", "decision": "ask", "reason": "Merging needs the owner." },
    { "tool": "^mcp__github__merge_pull_request$", "match": ".*", "decision": "ask", "reason": "Merges go through the Fable review gate." },
    { "tool": "^mcp__github__.*delete", "match": ".*", "decision": "deny", "reason": "Destructive GitHub operation." },
    { "tool": "^mcp__meta-ads__", "match": "\"status\"\\s*:\\s*\"ACTIVE\"", "decision": "ask", "reason": "Activating ads spends real money; create them paused." },
    { "tool": ".*", "match": "\"privacy(Status)?\"\\s*:\\s*\"public\"", "decision": "ask", "reason": "Publishing a video publicly can't be undone; upload private or unlisted first." }
  ]
}
