{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Question",
  "description": "What ask_user receives. Goes on the bus straight to Jarvis; the answer goes straight back to the asking agent.",
  "type": "object",
  "required": ["ticket_id", "asked_by", "path", "questions"],
  "additionalProperties": false,
  "properties": {
    "ticket_id": { "type": "string" },
    "asked_by": { "type": "string", "description": "agent id" },
    "path": { "type": "string", "description": "Human-readable chain, e.g. 'App Manager › iOS Developer'" },
    "blocking": { "type": "boolean", "default": false, "description": "false = keep working on the default while waiting" },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["text", "default"],
        "properties": {
          "text": { "type": "string", "maxLength": 200 },
          "options": { "type": "array", "items": { "type": "string" }, "maxItems": 4 },
          "default": { "type": "string" },
          "why": { "type": "string", "maxLength": 200 }
        }
      }
    }
  }
}
