{
  // OpenClaw as a messaging channel into AI City. Start it only with jarvis/openclaw/bin/gateway
  // (or bin/telegram-on for the LaunchAgent): it loads every secret from the Keychain, so no token
  // is ever typed on a command line or written into this file.
  // Loopback only, token required, no tunnels, no proxies, no discovery.
  gateway: {
    mode: "local",
    bind: "loopback",
    port: 18789,
    auth: { mode: "token", token: "${OPENCLAW_GATEWAY_TOKEN}" },
    controlUi: { enabled: false },
  },
  discovery: { mdns: { mode: "off" } },
  browser: { enabled: false },

  // The model backend: the owner's logged-in `claude` CLI. No API key, no token copied anywhere.
  agents: {
    defaults: {
      workspace: "./workspace",
      model: { primary: "anthropic/claude-haiku-5-5" },
      models: {
        "anthropic/claude-haiku-5-5": { agentRuntime: { id: "claude-cli" } },
        "anthropic/*": { agentRuntime: { id: "claude-cli" } },
      },
      modelPolicy: { allow: ["anthropic/claude-haiku-5-5"] },
    },
  },

  // The agent is a relay. Its only tool is ask_jarvis; everything else is denied.
  tools: {
    profile: "minimal",
    allow: ["ask_jarvis"],
    deny: [
      "group:runtime", "group:fs", "group:ui", "group:web", "group:nodes", "group:automation", "group:media", "group:sessions", "group:agents", "group:memory",
      "exec", "process", "read", "write", "edit", "apply_patch", "browser", "canvas", "cron", "gateway", "image", "nodes", "sessions_spawn", "sessions_send", "openclaw", "plugins",
    ],
    sessions: { visibility: "self" },
    elevated: { enabled: false },
  },

  // No ClawHub, no third-party skills. Only the plugin in this repo.
  skills: { allowBundled: [] },
  plugins: {
    allow: ["jarvis-relay"],
    load: { paths: ["./plugins/jarvis-relay"] },
    entries: {
      "jarvis-relay": { enabled: true, config: { server: "http://127.0.0.1:7777" } },
    },
  },

  // Telegram: direct messages from the owner's own account only. dmPolicy "allowlist" with his numeric
  // user ID, which bin/gateway exports as TELEGRAM_OWNER_ID from Keychain item jarvis.openclaw-telegram-owner.
  // Anyone else is dropped by OpenClaw before the agent sees it. If the ID is missing it stays an unresolved
  // literal that matches nobody, and bin/gateway refuses to start. No groups, no owner commands.
  // The bot token is NEVER written here (no botToken or tokenFile): bin/gateway exports TELEGRAM_BOT_TOKEN
  // from Keychain item jarvis.openclaw-telegram. Never run `channels add --token`: it writes the token here.
  channels: {
    telegram: {
      enabled: true,
      dmPolicy: "allowlist",
      allowFrom: ["${TELEGRAM_OWNER_ID}"],
      groupPolicy: "disabled",
    },
  },
}
