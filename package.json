{
  "name": "ai-city",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI City: an agent organization (city/) with Jarvis as its voice and text front door (jarvis/)",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "jarvis",
    "city",
    "jarvis/openclaw"
  ],
  "scripts": {
    "start": "npm start -w jarvis",
    "test": "npm test --workspaces --if-present",
    "policy:selftest": "python3 .claude/hooks/policy_gate.py --selftest",
    "test:voice": "cd jarvis/voice && uv run pytest -q"
  }
}
