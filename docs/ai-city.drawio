<mxfile host="app.diagrams.net"><diagram id="ai-city" name="AI City"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="AI City — Fixed Core + Dynamic Agents" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1380" height="30" as="geometry"/></mxCell><mxCell id="user" value="You" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="625" y="34" width="30" height="60" as="geometry"/></mxCell><mxCell id="jarvis" value="&lt;b&gt;Jarvis&lt;/b&gt;&lt;br&gt;&lt;small&gt;Haiku 5.5 · low · I/O, asks &amp;amp; relays&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="530" y="140" width="220" height="60" as="geometry"/></mxCell><mxCell id="tools" value="&lt;b&gt;Personal tools · fast path&lt;/b&gt;&lt;br&gt;&lt;small&gt;Calendar · Mail · Notes · Reminders · Spotify&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="120" y="140" width="300" height="60" as="geometry"/></mxCell><mxCell id="bus" value="&lt;b&gt;Question &amp;amp; Instruction Bus&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;small&gt;any agent ↔ you&lt;br&gt;tagged with agent path + ticket id&lt;br&gt;&lt;br&gt;questions batched, each with a default&lt;br&gt;&lt;br&gt;@agent instructions go direct, manager cc'd&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1270" y="140" width="150" height="560" as="geometry"/></mxCell><mxCell id="sec" value="&lt;b&gt;Executive Secretary&lt;/b&gt;&lt;br&gt;&lt;small&gt;Sonnet 5.5 · medium · summarizer&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="120" y="270" width="240" height="60" as="geometry"/></mxCell><mxCell id="orch" value="&lt;b&gt;Orchestrator&lt;/b&gt;&lt;br&gt;&lt;small&gt;Opus 5.5 · medium · plans, hires&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="530" y="270" width="220" height="60" as="geometry"/></mxCell><mxCell id="rev" value="&lt;b&gt;Reviewer Gate&lt;/b&gt;&lt;br&gt;&lt;small&gt;Fable 5.1 · medium · PR→main, push→dev, spend&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="900" y="270" width="300" height="60" as="geometry"/></mxCell><mxCell id="factory" value="&lt;b&gt;Agent Factory + Registry&lt;/b&gt; &lt;small&gt;— spec (role, model, tools, parent) → policy check → spawn · saved specialists reused · idle agents retired&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="1160" height="50" as="geometry"/></mxCell><mxCell id="zone" value="&lt;b&gt;Dynamic zone&lt;/b&gt; — nothing here exists until a prompt needs it" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontSize=13;dashed=1;dashPattern=8 4;fillColor=#fafafa;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="1160" height="230" as="geometry"/></mxCell><mxCell id="laneA" value="“Build an iOS app” → Swift chosen · persistent team" style="swimlane;startSize=26;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="zone"><mxGeometry x="20" y="40" width="540" height="175" as="geometry"/></mxCell><mxCell id="am" value="&lt;b&gt;App Manager&lt;/b&gt;&lt;br&gt;&lt;small&gt;Opus 5.5&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="laneA"><mxGeometry x="190" y="38" width="160" height="50" as="geometry"/></mxCell><mxCell id="ios" value="&lt;b&gt;iOS Developer&lt;/b&gt;&lt;br&gt;&lt;small&gt;Sonnet 5.5 · Swift / Xcode&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="laneA"><mxGeometry x="50" y="112" width="200" height="50" as="geometry"/></mxCell><mxCell id="qa" value="&lt;b&gt;QA Tester&lt;/b&gt;&lt;br&gt;&lt;small&gt;Sonnet 5.5 · simulator tests&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="laneA"><mxGeometry x="290" y="112" width="200" height="50" as="geometry"/></mxCell><mxCell id="laneB" value="“Plan a lake / mountain trip” → temporary team" style="swimlane;startSize=26;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="zone"><mxGeometry x="600" y="40" width="540" height="175" as="geometry"/></mxCell><mxCell id="tm" value="&lt;b&gt;Travel Manager&lt;/b&gt;&lt;br&gt;&lt;small&gt;Sonnet 5.5&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="laneB"><mxGeometry x="190" y="38" width="160" height="50" as="geometry"/></mxCell><mxCell id="fl" value="&lt;b&gt;Flights worker&lt;/b&gt;&lt;br&gt;&lt;small&gt;prices, dates, layovers&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="laneB"><mxGeometry x="50" y="112" width="200" height="50" as="geometry"/></mxCell><mxCell id="ho" value="&lt;b&gt;Hotels worker&lt;/b&gt;&lt;br&gt;&lt;small&gt;view filter: lake · mountain&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="laneB"><mxGeometry x="290" y="112" width="200" height="50" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Models:&lt;/b&gt; yellow Haiku · blue Opus · green Sonnet · purple Fable &amp;nbsp;|&amp;nbsp; &lt;b&gt;Lines:&lt;/b&gt; solid = delegation · orange dashed = questions / direct instructions · red = review rejection · dashed boxes = spawned at runtime" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="715" width="1380" height="30" as="geometry"/></mxCell><mxCell id="e1" value="prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="jarvis"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="reply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.6;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="jarvis" target="user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="direct" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="jarvis" target="tools"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="ask / answer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#d79b00;startArrow=classic;entryX=0;entryY=0.054;entryDx=0;entryDy=0;" edge="1" parent="1" source="jarvis" target="bus"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="task" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="jarvis" target="orch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="results" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="orch" target="sec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="summary" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.15;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sec" target="jarvis"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="review" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="orch" target="rev"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="FAIL → fix" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;fontColor=#B20000;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="rev" target="orch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="hire" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="1" source="orch" target="factory"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="spawns" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;" edge="1" parent="1" source="factory" target="zone"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="ask / instruct" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#d79b00;startArrow=classic;" edge="1" parent="1" source="zone" target="bus"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="laneA" source="am" target="ios"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="laneA" source="am" target="qa"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="laneB" source="tm" target="fl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="laneB" source="tm" target="ho"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
